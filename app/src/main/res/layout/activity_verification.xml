<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_racine_mg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/img_passeport_mg"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.3"
        android:background="#16324F"
        android:contentDescription="Image du passeport"
        android:padding="16dp"
        app:srcCompat="@drawable/ic_horloge"
        app:tint="#FFFFFF" />

    <RelativeLayout
        android:id="@+id/layout_infos_mg"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.7"
        android:background="#FBFAF6"
        android:padding="20dp">

    </RelativeLayout>

</LinearLayout>